// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
	"dockerFile": "../docker/Dockerfile.dev",
	"build": {
		"args": {
			"WORKSPACE": "${containerWorkspaceFolder}",
			"USERNAME": "ros",
			"WORKDIR": "libs/"
		}
	},
	"remoteUser": "ros",
	"runArgs": [
		"--cap-add=SYS_PTRACE",
		"--security-opt=seccomp:unconfined",
		"--security-opt=apparmor:unconfined"
	],
	// --network=host and X11 are Linux-only; publish the API port and run turtlesim under xvfb-run.
	// Packages-dir mount: ROS_PKG_SOURCE is relative to this repo on the host, ROS_PKG_TARGET relative to the container workspace.
	"forwardPorts": [8000],
	"mounts": [
		"source=${localWorkspaceFolder}/${localEnv:ROS_PKG_SOURCE:../packages},target=${containerWorkspaceFolder}/${localEnv:ROS_PKG_TARGET:src/packages},type=bind"
	],
	"containerEnv": {
		"LIBGL_ALWAYS_SOFTWARE": "1" // Needed for software rendering of opengl
	},
	// Set *default* container specific settings.json values on container create.
	"settings": {
		"terminal.integrated.profiles.linux": {
			"bash": {
				"path": "bash"
			}
		},
		"terminal.integrated.defaultProfile.linux": "bash"
	},
	"extensions": [
		"althack.ament-task-provider",
		"DotJoshJohnson.xml",
		"ms-azuretools.vscode-docker",
		"ms-python.python",
		"ms-vscode.cpptools",
		"redhat.vscode-yaml",
		"smilerobotics.urdf",
		"streetsidesoftware.code-spell-checker",
		"twxs.cmake",
		"yzhang.markdown-all-in-one",
		"zachflower.uncrustify"
	]
}
